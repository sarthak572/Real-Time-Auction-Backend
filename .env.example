NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://auction:auction@localhost:5432/auction
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379
AUCTION_CACHE_TTL_SECONDS=30
LIST_CACHE_TTL_SECONDS=2
WS_MAX_CONNECTIONS=10000
WS_MAX_CONNECTIONS_PER_IP=50
WS_HEARTBEAT_MS=25000
WS_MAX_BUFFERED_BYTES=1048576
WS_MAX_PAYLOAD_BYTES=1024
WS_CATCHUP_MAX=100
STATE_REDIS_URL=redis://localhost:6380
BID_IMPL=redis
FLUSH_INTERVAL_MS=200
FLUSH_BATCH_SIZE=1000
WB_MAX_BACKLOG=100000
FLUSHER_IN_PROCESS=false
TRUST_PROXY=false
# INSTANCE_ID=api-3001
# API_HOST_IP=192.168.65.254   # how nginx (in Docker) reaches your PC; see docker-compose.yml
# Logging volume (unset = verbose in development, lean in production)
# LOG_REQUESTS=false   # Fastify request lines; lean mode still logs 5xx and slow requests
# LOG_SAMPLE_RATE=0.01 # share of routine bid events logged (events carry sampleRate)
# LOG_ASYNC=true       # buffered log writes
# LOG_SLOW_MS=500
# Write-behind bid path
BID_BATCH=true           # send bids from the same event-loop turn as one Redis write
PUBLISH_IN_SCRIPT=true   # publish the live event inside the bid script
IDEMPOTENCY_TTL_SECONDS=600
IDEMPOTENCY_MEMORY_LIMIT=0.8   # refuse new Idempotency-Keys above this share of state Redis memory
FLUSHER_METRICS_PORT=9101
